# 全链路真实模式配置模板
# start-fullchain.ps1 在发现 .env.local 不存在时会自动把本文件复制成 .env.local
# 之所以不直接提交 .env.local：仓库 .gitignore 里把它当作本地私有配置忽略了

VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8081
VITE_SENSOR_API_URL=/sensor-api
VITE_SENSOR_CHART_URL=/sensor-chart
VITE_SENSOR_PROXY_TARGET=http://127.0.0.1:5058
VITE_FACE_API_URL=/face-api
VITE_FACE_PROXY_TARGET=http://127.0.0.1:5001
VITE_PORT=5173
# 关键：关掉内置 mock，所有业务接口打真实 Spring Boot
VITE_USE_MOCK=false
VITE_AGENT_MODE=local
VITE_AGENT_PROXY_TARGET=http://127.0.0.1:8787
